PORT=8080
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Get a key at https://aistudio.google.com/apikey  (leave empty to run regex-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000
# '*' for same-origin deploys; for Vercel+Render set your frontend URL (comma-separated for several)
CORS_ORIGIN=*
DB_PATH=./data/promptshield.db
DEMO_EMAIL=demo@promptshield.dev
DEMO_PASSWORD=Demo@1234

# Webhook URL for alerting on high-risk prompts
# WEBHOOK_URL=your_discord_webhook_url_here

# Upstream API settings for proxy
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=your_upstream_api_key_here

# Daily downstream quota limit
# DOWNSTREAM_DAILY_LIMIT=25
